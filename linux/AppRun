#!/usr/bin/env bash
# The AppImage's entry point: start the bundled orx as the desktop app (see
# src/commands/app.rs). Only an openresearch: link or a .orx file (the desktop
# entry's %u) is passed on; the CLI is `orx`, not this.
set -e

export APPDIR="${APPDIR:-"$(dirname "$(realpath "$0")")"}"

# The session's values of what this script and the hook below override, as
# `=<value>` or `-` for unset, so orx can hand them back to the host programs it
# opens (shell_env::host_gui_env; keep the two lists in step).
for var in LD_LIBRARY_PATH GDK_BACKEND GDK_PIXBUF_MODULE_FILE GI_TYPELIB_PATH GIO_EXTRA_MODULES \
  GIO_MODULE_DIR GSETTINGS_SCHEMA_DIR GTK_DATA_PREFIX GTK_EXE_PREFIX GTK_IM_MODULE_FILE GTK_PATH \
  GTK_THEME XDG_DATA_DIRS; do
  if [ -n "${!var+set}" ]; then
    export "ORX_HOST_$var==${!var}"
  else
    export "ORX_HOST_$var=-"
  fi
done

cd "$APPDIR/usr"
runtime_log="$(mktemp)"
trap 'rm -f "$runtime_log"' EXIT
runtime="$APPDIR/usr/bin/orx-runtime"
check_runtime() {
  (ulimit -c 0; timeout 15 "$runtime" check)
}
system_lib=
if system_lib="$(check_runtime 2>"$runtime_log")"; then
  case "$system_lib/" in
    "$APPDIR/"*) system_lib= ;;
    *)
      if ! LD_LIBRARY_PATH="$system_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" check_runtime >>"$runtime_log" 2>&1 || \
        ! LD_LIBRARY_PATH="$system_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        LD_BIND_NOW=1 ORX_TELEMETRY_ENV=off timeout 10 "$APPDIR/usr/bin/orx" version >/dev/null 2>>"$runtime_log"; then
        system_lib=
      fi
      ;;
  esac
fi
if [ -n "$system_lib" ]; then
  export LD_LIBRARY_PATH="$system_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export ORX_APPIMAGE_RUNTIME=system
else
  # linuxdeploy-plugin-gtk's hook points GTK at the bundled modules and schemas.
  for hook in "$APPDIR"/apprun-hooks/*.sh; do
    if [ -e "$hook" ]; then
      # shellcheck disable=SC1090
      . "$hook"
    fi
  done
  # Let GTK choose the session's backend unless the user selected one; the plugin
  # forces X11 even in a Wayland session.
  case "$ORX_HOST_GDK_BACKEND" in
    =*) export GDK_BACKEND="${ORX_HOST_GDK_BACKEND#=}" ;;
    -) unset GDK_BACKEND ;;
  esac
  # Only the bundled GIO modules (TLS): the host's need a newer GLib than the image's.
  export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"
  unset GIO_EXTRA_MODULES
  export ORX_APPIMAGE_RUNTIME=bundled
  if ! LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" check_runtime >>"$runtime_log" 2>&1 || \
    ! LD_BIND_NOW=1 ORX_TELEMETRY_ENV=off timeout 10 "$APPDIR/usr/bin/orx" version >/dev/null 2>>"$runtime_log"; then
    cat "$runtime_log" >&2
    rm -f "$runtime_log"
    trap - EXIT
    exec env LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$runtime" error "OpenResearch could not find compatible WebKitGTK / GStreamer media libraries.

Install the system libraries, then reopen OpenResearch:

Ubuntu / Debian:
sudo apt install libwebkit2gtk-4.1-0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-libav

Arch Linux:
sudo pacman -S --needed webkit2gtk-4.1 gst-plugins-base-libs gst-plugins-good gst-libav"
  fi
fi
rm -f "$runtime_log"
trap - EXIT

# scripts/build-linux-appimage.sh rewrote libwebkit2gtk's /usr paths to ././,
# so WebKit finds its bundled helper processes relative to this directory.
link=()
# Any position: AppImage integrators keep the bundled entry's `app` before %u.
shopt -s nocasematch
for arg in "$@"; do
  case "$arg" in
    openresearch:* | *.orx) link=("$arg"); break ;;
  esac
done
shopt -u nocasematch
exec "$APPDIR/usr/bin/orx" app "${link[@]}"
